<?xml version="1.0" encoding="utf-8"?>
<resources> <!-- A Spinner style that forces white text -->
    <style name="WhiteSpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:popupTheme">@style/WhiteSpinnerPopupStyle</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="WhiteSpinnerPopupStyle" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">@color/white</item>
    </style>
</resources>